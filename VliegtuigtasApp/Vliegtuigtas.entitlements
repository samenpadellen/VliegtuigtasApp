<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.vliegtuigtas.app</string>
	</array>
	<!-- Expliciete id (niet $(CFBundleIdentifier)): de watch-app deelt
	     dezelfde iCloud key-value store en heeft een andere bundle-id. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.vliegtuigtas.app</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Zelfde iCloud key-value store als de telefoon-app: zo leest het
	     vertrekbord de daar opgeslagen reis/vlucht, zonder eigen account of
	     login. Expliciete id (niet $(CFBundleIdentifier)), net als bij de
	     Watch-app: tvOS heeft een andere bundle-id maar deelt dezelfde store. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.vliegtuigtas.app</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Expliciete id (niet $(CFBundleIdentifier)): dit target deelt dezelfde
	     bundle-id als de hoofdapp (Universal Purchase), dus dat zou hier
	     toevallig ook goed uitkomen — maar expliciet is robuust tegen een
	     eventuele toekomstige bundle-id-wijziging, en houdt deze regel
	     identiek aan Vliegtuigtas.entitlements en VliegtuigtasWatch.entitlements. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.vliegtuigtas.app</string>
</dict>
</plist>
